{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beat",
  "type": "object",
  "required": ["beat_id","ep","seq","world_time","location",
               "present","witnessed_by","hidden_from",
               "what_happened","source_ref","tier"],
  "properties": {
    "beat_id":      {"type": "string"},
    "ep":           {"type": "integer"},
    "seq":          {"type": "integer"},
    "world_time":   {"type": "string", "description": "ISO 8601, may be partial"},
    "location":     {"type": "string"},
    "present":      {"type": "array", "items": {"type": "string"}},
    "witnessed_by": {"type": "array", "items": {"type": "string"},
                     "description": "present, or credibly told later"},
    "hidden_from":  {"type": "array", "items": {"type": "string"},
                     "description": "named characters who do NOT know this. Fill deliberately."},
    "what_happened":{"type": "string", "description": "one objective sentence, no style"},
    "state_changes":{"type": "array", "items": {
       "type": "object",
       "required": ["entity","fact","valence"],
       "properties": {
         "entity":  {"type": "string"},
         "fact":    {"type": "string"},
         "valence": {"type": "integer", "minimum": -5, "maximum": 5}
       }}},
    "source_ref":   {"type": "string",
                     "description": "dossier timeline id, or the literal 'fictionalized'"},
    "tier":         {"enum": ["core_canon","branch_canon"]},
    "pov":          {"type": "string", "description": "set on branch_canon only"},
    "note":         {"type": "string"}
  }
}
