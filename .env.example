OPENAI_API_KEY=

# Model routing. Sol writes, Luna scores. See docs/ARCHITECTURE.md.
OPENAI_MODEL_WRITER=gpt-5.6-sol
OPENAI_MODEL_SCORER=gpt-5.6-luna
OPENAI_MODEL_VALIDATOR=gpt-5.6-sol

# The scout falls back to OPENAI_MODEL_SCORER when unset. Its first run on luna
# made 6 searches for 8 categories and drifted to famous Western cases; that was
# mostly structural and is now fixed with per-category calls and a search floor.
# If a rerun still comes back famous, raise this rather than tuning the prompt.
# OPENAI_MODEL_SCOUT=gpt-5.6-sol

# Discovery only. Not needed to run the demo.
IK_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Set to 1 to serve every LLM response from data/cache. Demo kill switch.
# When set, a cache miss raises instead of silently calling the API.
OFFLINE=0

# Text to speech. Needed only to record audio, not to generate scripts.
# Recording also needs ffmpeg on the PATH - pydub shells out to it and pip
# cannot supply it. Windows: winget install Gyan.FFmpeg
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
