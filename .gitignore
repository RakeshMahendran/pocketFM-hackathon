.venv/
.worktrees/
# databricks sync snapshot state - local to one machine, not shared config
.databricks/
__pycache__/
*.pyc
.env
data/canon.db
.DS_Store

data/voice_work/

# The Apps build step runs `npm install` at the root and leaves a lockfile
# behind. Committing one would give Turbopack two to choose between, which is
# what made it pick the repo root as the workspace and warn — web/ owns the
# only lockfile that should exist.
/package-lock.json

# Spinoff LLM responses. The slice does not replay from these — `demo_seed` and
# the API read the finished episodes in data/spinoffs/, which are committed,
# readable, and survive a refactor that changes a cache key. Keeping these is a
# local convenience so iterating does not re-pay for the same call; committing
# them was 150 files of nothing anyone reads.
#
# Scoped to our own stages on purpose: hunt_* feeds the scout replay screen and
# serial_* came with the season writer. Neither is ours to drop.
data/cache/promote_*
data/cache/spinoff_*
data/cache/panel_*
data/cache/season_*
data/cache/calls/promote_*
data/cache/calls/spinoff_*
data/cache/calls/panel_*
data/cache/calls/season_*
# The season-writer spike, run against a synthesized spinoff dossier. Not a real
# serial and not on any path — delete these whenever.
data/cache/serial_*__*
data/cache/calls/serial_*__*

# Clips from the mock provider — a generated tone, not a voice. They exist so the
# chain can be exercised without spending Sarvam credits, and the offline demo
# never plays one. The real clips beside them ARE committed: `data/cache/voice`
# is what makes a demo with no network possible.
data/cache/voice/mock_*

# Recorded demo take. An artifact of the presentation, not a source file.
demo_walkthrough.mp4
